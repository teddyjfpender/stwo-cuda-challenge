diff --git a/src/integrations/circuit_cuda/tests/grind_regression.py b/src/integrations/circuit_cuda/tests/grind_regression.py
new file mode 100644
index 00000000..f73de1c1
--- /dev/null
+++ b/src/integrations/circuit_cuda/tests/grind_regression.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Focused NVIDIA PoW checks; no prover fixtures or security settings changed.
+
+Run from the prover root with CUDA/nvcc on PATH:
+  python3 src/integrations/circuit_cuda/tests/grind_regression.py
+Add --baseline /path/to/pinned/source --repetitions 9 for paired call timings.
+The timer includes allocation, transfers, search, synchronization and teardown
+of one circuit grind call, not a proof stage or complete prover command.
+"""
+
+import argparse
+import ctypes
+import hashlib
+import json
+from pathlib import Path
+import statistics
+import struct
+import subprocess
+import tempfile
+import time
+
+P = (1 << 31) - 1
+LIMIT = P << 20
+NONE = (1 << 64) - 1
+U32 = ctypes.c_uint32
+U64 = ctypes.c_ulonglong
+
+
+def build(source, directory, name):
+    library = directory / (name + '.so')
+    subprocess.run(['nvcc', '-std=c++17', '-O3', '-arch=sm_90',
+                    '-shared', '-Xcompiler=-fPIC',
+                    str(source / 'src/integrations/circuit_cuda/native/circuit_grind.cu'),
+                    '-o', str(library)], check=True)
+    dll = ctypes.CDLL(str(library))
+    fn = dll.stwo_circuit_cuda_blake2s_grind
+    fn.argtypes = [ctypes.POINTER(U32), U32, U32, U64, ctypes.POINTER(U64)]
+    fn.restype = ctypes.c_int
+    return fn
+
+
+def grind(fn, prefix, bits, m31, end=LIMIT):
+    result = U64(NONE)
+    words = (U32 * 8)(*struct.unpack('<8I', prefix))
+    code = fn(words, bits, m31, end, ctypes.byref(result))
+    if code:
+        raise RuntimeError(f'CUDA grind failed with status {code}')
+    return result.value
+
+
+def oracle(prefix, bits, m31, end):
+    for index in range(end):
+        nonce = ((index >> 20) << 32) | (index & ((1 << 20) - 1))
+        word = struct.unpack('<I', hashlib.blake2s(
+            prefix + struct.pack('<Q', nonce)).digest()[:4])[0]
+        if m31:
+            word %= P
+        if word & ((1 << bits) - 1) == 0:
+            return nonce
+    return NONE
+
+
+def prefix_for(seed, m31):
+    raw = hashlib.sha256(f'stwo-cuda-pow-regression-{seed}'.encode()).digest()
+    if m31:
+        raw = struct.pack('<8I', *(word % P for word in struct.unpack('<8I', raw)))
+    return raw
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=Path(__file__).resolve().parents[4])
+    parser.add_argument('--baseline', type=Path)
+    parser.add_argument('--repetitions', type=int, default=9)
+    args = parser.parse_args()
+    if args.repetitions < 1:
+        parser.error('repetitions must be positive')
+    with tempfile.TemporaryDirectory(prefix='stwo-pow-check-') as tmp:
+        directory = Path(tmp)
+        candidate = build(args.source.resolve(), directory, 'candidate')
+        checks = 0
+        for m31 in (0, 1):
+            for seed in range(6):
+                prefix = prefix_for(seed, m31)
+                for bits, end in ((1, 37), (8, 33), (12, 4097), (32, 262145)):
+                    expected = oracle(prefix, bits, m31, end)
+                    assert grind(candidate, prefix, bits, m31, end) == expected
+                    checks += 1
+            # Cross the low-word lattice boundary without replacing it by a
+            # contiguous u64 search. A 32-bit predicate normally has no hit.
+            prefix = prefix_for(99, m31)
+            end = (1 << 20) + 37
+            assert grind(candidate, prefix, 32, m31, end) == oracle(prefix, 32, m31, end)
+            checks += 1
+        print(json.dumps({'oracle_checks': checks}), flush=True)
+        if args.baseline is None:
+            return
+        baseline = build(args.baseline.resolve(), directory, 'baseline')
+        for fn in (baseline, candidate):
+            grind(fn, prefix_for(0, 0), 8, 0)
+        for m31 in (0, 1):
+            for bits in (8, 20, 24, 26):
+                samples = {'baseline': [], 'candidate': []}
+                for rep in range(args.repetitions):
+                    prefix = prefix_for(1000 + rep, m31)
+                    nonces = []
+                    # ABBA, with a fresh prefix per repetition and identical
+                    # input in the four calls; retain all raw observations.
+                    for label, fn in (('baseline', baseline), ('candidate', candidate),
+                                      ('candidate', candidate), ('baseline', baseline)):
+                        start = time.perf_counter_ns()
+                        nonces.append(grind(fn, prefix, bits, m31))
+                        samples[label].append((time.perf_counter_ns() - start) / 1e6)
+                    assert len(set(nonces)) == 1 and nonces[0] != NONE
+                print(json.dumps({'m31': m31, 'bits': bits,
+                                  'scope': 'synchronous circuit grind call, milliseconds',
+                                  'median_ms': {k: statistics.median(v) for k, v in samples.items()},
+                                  'median_paired_ratio': statistics.median(
+                                      sum(samples['candidate'][i:i+2]) / sum(samples['baseline'][i:i+2])
+                                      for i in range(0, 2*args.repetitions, 2)),
+                                  'samples_ms': samples}), flush=True)
+
+
+if __name__ == '__main__':
+    main()
